# RAG Service Environment Variables
# Copy this to .env and fill in your values

# Google AI Studio API Key (get free at https://aistudio.google.com)
GOOGLE_API_KEY=your_google_api_key_here

# MongoDB Connection (reuse from CivicPulse backend)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/civicpulse

# ChromaDB Settings
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_DOCS=civicpulse_docs
CHROMA_COLLECTION_GOV=gov_schemes

# LLM Settings
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Retrieval Settings
RETRIEVAL_TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# Server Settings
RAG_SERVICE_HOST=0.0.0.0
RAG_SERVICE_PORT=8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=20
